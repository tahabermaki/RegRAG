# Copie ce fichier en .env (make env le fait pour toi). Ne commite JAMAIS .env.

# --- Stockage ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=regrag_v1
POSTGRES_DB=regrag
POSTGRES_USER=regrag
POSTGRES_PASSWORD=regrag
POSTGRES_DSN=postgresql://regrag:regrag@postgres:5432/regrag
REDIS_URL=redis://redis:6379/0

# --- Modèles (phases 1-2) ---
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
LLM_MODEL=mistral/mistral-small-latest
LLM_FALLBACK_MODEL=openai/gpt-4o-mini
MISTRAL_API_KEY=
OPENAI_API_KEY=

# --- Paramètres du RAG ---
RETRIEVAL_TOP_K=50
RERANK_TOP_K=5
REFUSAL_THRESHOLD=0.3

# --- Observabilité ---
LOG_LEVEL=INFO
GRAFANA_PASSWORD=admin
